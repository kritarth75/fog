# Prototype runs fine WITHOUT Mongo: if MongoDB is unreachable, the backend
# logs a warning and keeps working with in-memory-only state.
MONGODB_URI=mongodb://127.0.0.1:27017/fogsafe
PORT=4000
# Comma-separated frontend origin(s). REQUIRED in production, e.g. https://fogsafe.vercel.app
CORS_ORIGIN=
